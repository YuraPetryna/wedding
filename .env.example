# ─────────────────────────────────────────────────────────────
#  Скопіюйте цей файл у .env.local і заповніть.
#  Значення з групи «Google» вам згенерує:  npm run auth
# ─────────────────────────────────────────────────────────────

# ── Google (серверні, НЕ потрапляють у браузер) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ID папки на Диску, куди складати фото (створює npm run auth)
DRIVE_FOLDER_ID=

# ID таблиці «Книга побажань». Необов'язково: без неї ім'я та
# побажання все одно зберігаються в назві й описі кожного фото.
GUESTBOOK_SHEET_ID=

# Створювати окрему підпапку на кожного гостя (true / false)
CREATE_GUEST_SUBFOLDERS=true

# Максимальний розмір одного файлу, МБ (серверна перевірка)
MAX_FILE_MB=512


# ── Публічні (вшиваються у сторінку) ────────────────────────
NEXT_PUBLIC_BRIDE=Олена
NEXT_PUBLIC_GROOM=Андрій
NEXT_PUBLIC_WEDDING_DATE=2026-09-12
NEXT_PUBLIC_HASHTAG=#ОленаІАндрій2026

# Адреса після деплою — потрібна для QR-коду та OpenGraph.
# Поки не знаєте — краще НЕ додавати цей ключ узагалі, ніж додати порожнім.
# (Порожнє значення сайт переживе, але сенсу від нього нуль: підставиться
#  адреса деплою від Vercel або запасна.)
NEXT_PUBLIC_SITE_URL=https://nashe-vesillya.vercel.app

# Той самий ліміт, але для підказки в інтерфейсі
NEXT_PUBLIC_MAX_FILE_MB=512
